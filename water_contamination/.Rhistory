library(lubridate)
trend <- read_csv("data/nitrate_trend_daily.csv") %>%
mutate(year  = year(date),
month = month(date)) %>%
filter(month %in% 3:10,
year <= 2025)
# ---- Method B pieces: one median per site per month ---------------------------
monthly <- trend %>%
group_by(site_id, year, month) %>%
summarise(month_median = median(nitrate_mgL), .groups = "drop")
# ---- Both methods, one row per site-year -------------------------------------
site_year <- trend %>%
group_by(site_id, year) %>%
summarise(n_samples  = n(),
n_months   = n_distinct(month),
median_A   = median(nitrate_mgL),          # A: all samples in the year
.groups = "drop") %>%
left_join(
monthly %>%
group_by(site_id, year) %>%
summarise(median_B = median(month_median),     # B: median of monthly medians
.groups = "drop"),
by = c("site_id", "year")
) %>%
mutate(diff     = median_B - median_A,
pct_diff = 100 * diff / median_A)
# ---- Compare --------------------------------------------------------------------
# How often do they disagree, and by how much?
summary(site_year$diff)
quantile(abs(site_year$diff), c(0.5, 0.75, 0.9, 0.95, 0.99))
# A vs B: points on the diagonal agree
ggplot(site_year, aes(median_A, median_B)) +
geom_abline(color = "grey60") +
geom_point(alpha = 0.3, size = 1) +
scale_x_log10() + scale_y_log10() +
labs(x = "A: median of all samples (mg/L)",
y = "B: median of monthly medians (mg/L)")
# Does disagreement depend on how evenly the year was sampled?
site_year %>%
mutate(samples_per_month = n_samples / n_months) %>%
ggplot(aes(samples_per_month, abs(diff))) +
geom_point(alpha = 0.3, size = 1) +
labs(x = "Samples per month (higher = more bunched in some months)",
y = "|B - A| (mg/L)")
# Biggest disagreements, to eyeball
site_year %>%
arrange(desc(abs(diff))) %>%
head(20) %>%
as.data.frame()
# How many site-years survive a minimum-months rule?
site_year %>%
summarise(total      = n(),
months_2up = sum(n_months >= 2),
months_3up = sum(n_months >= 3),
months_4up = sum(n_months >= 4))
site_year
site_year %>%
arrange(desc(abs(diff))) %>%
head(20) %>%
as.data.frame()
site_year
site_regions <- hist_sites %>%
st_drop_geometry() %>%
distinct(site_id, region)
site_year_reg <- site_year %>%
# filter(n_months >= 3) %>%      # optional: drop thinly sampled years
left_join(site_regions, by = "site_id")
region_year <- site_year_reg %>%
group_by(region, year) %>%
summarise(year_med = median(median_B),
n_sites  = n(),
.groups = "drop")
statewide <- site_year_reg %>%
group_by(year) %>%
summarise(year_med = median(median_B),
n_sites  = n(),
.groups = "drop")
ggplot(region_year, aes(year, year_med, color = region)) +
geom_line() +
geom_point(aes(size = n_sites), alpha = 0.6) +
geom_line(data = statewide, aes(year, year_med), inherit.aes = FALSE,
color = "black", linetype = "dashed", linewidth = 0.8) +
scale_size_area(max_size = 3, name = "Sites") +
labs(x = NULL, y = "Median of site-year medians (mg/L)",
color = NULL,
title = "Simple median version (no site-mix correction)",
subtitle = "Dashed = statewide") +
theme_minimal()
library(tidyverse)
# ---- Inputs: method B site-years, with the quality rules --------------------------
min_months     <- 3    # months sampled in a year for that site-year to count
min_site_years <- 5    # years a site needs to be included at all
min_sites      <- 15   # sites a region-year needs for its point to be plotted
trend_input <- site_year %>%
filter(n_months >= min_months) %>%
left_join(site_regions, by = "site_id") %>%
group_by(site_id) %>%
filter(n_distinct(year) >= min_site_years) %>%
ungroup()
# ---- Method 1: simple median (your current version, for comparison) -------------
simple_trend <- function(df) {
df %>%
group_by(year) %>%
summarise(simple = median(median_B), n_sites = n(), .groups = "drop")
}
# ---- Method 2: median polish ----------------------------------------------------
# site x year table -> overall level + site effect + year effect.
# overall + year effect = the regional line in mg/L.
polish_trend <- function(df) {
mat <- df %>%
select(site_id, year, median_B) %>%
pivot_wider(names_from = year, values_from = median_B) %>%
column_to_rownames("site_id") %>%
as.matrix()
mat <- mat[, order(as.numeric(colnames(mat))), drop = FALSE]
mp <- medpolish(mat, na.rm = TRUE, trace.iter = FALSE)
tibble(year = as.numeric(names(mp$col)),
polish = mp$overall + mp$col)
}
# ---- Method 3: regression with site effects (log scale) -------------------------
# log(value) ~ year + site. Year coefficients = change vs the first year.
# Converted back to mg/L for an "average site" so it sits on the same axis.
reg_trend <- function(df) {
df <- df %>%
mutate(year_f = factor(year),
y      = log(pmax(median_B, 0.01)))   # guard against zeros
fit  <- lm(y ~ year_f + site_id, data = df)
cf   <- coef(fit)
yrs  <- levels(df$year_f)
terms <- paste0("year_f", yrs[-1])
year_eff <- c(0, cf[terms])
site_eff <- c(0, cf[grep("^site_id", names(cf))])
base     <- cf["(Intercept)"] + mean(site_eff, na.rm = TRUE)
ci       <- confint(fit)[terms, , drop = FALSE]
tibble(year       = as.numeric(yrs),
regression = exp(base + year_eff),
reg_lo     = exp(base + c(0, ci[, 1])),
reg_hi     = exp(base + c(0, ci[, 2])))
}
# ---- Run all three for statewide + each region ----------------------------------
run_all <- function(df, ...) {
simple_trend(df) %>%
left_join(polish_trend(df), by = "year") %>%
left_join(reg_trend(df),    by = "year")
}
trend_results <- bind_rows(
trend_input %>% mutate(region = "Statewide"),
trend_input
) %>%
group_by(region) %>%
group_modify(run_all) %>%
ungroup() %>%
mutate(across(c(simple, polish, regression, reg_lo, reg_hi),
~ if_else(n_sites >= min_sites, .x, NA_real_)))   # hide thin years
# ---- Compare -----------------------------------------------------------------------
trend_long <- trend_results %>%
pivot_longer(c(simple, polish, regression), names_to = "method", values_to = "mgL") %>%
mutate(method = recode(method,
simple     = "Simple median",
polish     = "Median polish",
regression = "Regression (site effects)"))
ggplot(trend_long, aes(year, mgL, color = method)) +
geom_ribbon(data = trend_results,
aes(year, ymin = reg_lo, ymax = reg_hi), inherit.aes = FALSE,
fill = "grey80", alpha = 0.5) +
geom_line(linewidth = 0.8) +
geom_point(size = 1) +
facet_wrap(~ region, scales = "free_y") +
scale_color_manual(values = c("Simple median" = "grey55",
"Median polish" = "#1f6f92",
"Regression (site effects)" = "#d95f02")) +
labs(x = NULL, y = "Nitrate (mg/L as N)", color = NULL,
subtitle = "Grey band = regression 95% interval (relative to the first year)") +
theme_minimal() +
theme(legend.position = "bottom")
# Overall change, first 3 years vs last 3 years, per method
trend_results %>%
group_by(region) %>%
summarise(across(c(simple, polish, regression),
~ mean(tail(na.omit(.x), 3)) - mean(head(na.omit(.x), 3)),
.names = "{.col}_change_mgL")) %>%
as.data.frame()
both_ends <- trend_input %>%
group_by(site_id) %>%
filter(sum(year <= 2011) >= 2, sum(year >= 2019) >= 2) %>%
ungroup()
n_distinct(both_ends$site_id)
count(distinct(both_ends, site_id, region), region)
both_ends %>%
mutate(region = "Statewide") %>%
bind_rows(both_ends) %>%
group_by(region, year) %>%
summarise(fixed_simple = median(median_B), n_sites = n(), .groups = "drop") %>%
left_join(trend_results %>% select(region, year, polish), by = c("region", "year")) %>%
